# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/emimanagement

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Email (SMTP via MailerSend or any SMTP provider)
MAIL_HOST=smtp.mailersend.net
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@emimanagement.com
MAIL_FROM_NAME=EMI Management

# Admin email (contact form recipient)
ADMIN_EMAIL=admin@emimanagement.com

# File Storage
UPLOAD_DEST=uploads
MAX_FILE_SIZE_MB=2
